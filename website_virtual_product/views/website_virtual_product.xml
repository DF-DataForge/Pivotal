    <template id="inherited_website_sale_cart_website_virtual_product" inherit_id="website_sale.cart_lines" name="website virtual product template">
      <xpath expr="//a[hasclass('js_delete_product')]" position="attributes">
        <attribute name="t-if">not line.is_virtual or (line.auction_product_direct_buy and 'website.auction.config.settings' in request.env and request.env['website.auction.config.settings'].sudo().search([],limit=1).remove_cart_derect_buy_bid_product)</attribute>
      </xpath>
      <xpath expr="//button[hasclass('js_delete_product')]" position="attributes">
        <attribute name="t-if">not line.is_virtual or (line.auction_product_direct_buy and 'website.auction.config.settings' in request.env and request.env['website.auction.config.settings'].sudo().search([],limit=1).remove_cart_derect_buy_bid_product)</attribute>
      </xpath>
      <xpath expr="//div[@name='o_wsale_cart_line_button_container']" position="inside">
        <span class="span_is_virtual" id="span_is_virtual" t-if="line.is_virtual">
          <a t-att-data-virtual_source="line.virtual_source" t-att-href="'/remove/virtualproduct/'+str(line.id)" class="small wk_virtual_cart_remove">
            <i class="fa fa-trash-o wk_auto_remove"/> Remove
          </a>
          <a id="auto_remove" t-att-data-website_order_line="website_sale_order.website_order_line" t-if="len(website_sale_order.website_order_line)==1 or (int(website_sale_order.amount_total) &lt; 0)"/>
        </span>
      </xpath>
    </template>

    <template id="inherited_cart_lines_quantity_website_virtual_product" inherit_id="website_sale.cart_lines_quantity" name="website virtual product cart quantity">
      <xpath expr="//div[contains(@t-attf-class, 'css_quantity')]" position="attributes">
        <attribute name="t-att-style">'display: none;' if line.is_virtual else ''</attribute>
      </xpath>
    </template>
  </data>
</odoo>
