        <!-- The auction shop page reuses the standard /shop rendering (grid,
             filters, pricelists, pager, ...): it is a primary copy of
             website_sale.products, only decorated with the auction header and
             the Live/Upcoming auctions selector. The auction product filter
             itself is applied through website._product_domain(). -->
        <template id="product_on_auction" name="Products on Auction" inherit_id="website_sale.products" primary="True">
            <xpath expr="//t[@t-set='additional_title']" position="replace">
                <t t-set="additional_title">Products on Auction</t>
            </xpath>
            <xpath expr="//div[@id='o_wsale_container']" position="before">
                <span class="d-flex justify-content-center mt-2">
                    <img class="me-2" src="/website_auction/static/src/img/auction_hammer.png" style="height:50px;" alt="Auction"/>
                    <h2>Product Auction</h2>
                </span>
            </xpath>
            <xpath expr="//div[hasclass('o_wsale_products_main_row')]" position="before">
                <div class="d-flex justify-content-end mb-2">
                    <t t-set="auction_sortable" t-value="website._get_auctions_sort_mapping()"/>
                    <t t-set="auctionSortingBy" t-value="[sort for sort in auction_sortable if sort[0]==request.params.get('auction', '')]"/>
                    <t t-call="website_auction.sort_by_auctions">
                        <t t-set="_classes" t-valuef="d-none d-lg-inline-block ms-3 me-3"/>
                    </t>
                </div>
            </xpath>
        </template>

        <template id="sort_by_auctions" name="Sort-by Auctions">
            <div t-attf-class="o_sortby_dropdown dropdown dropdown_sorty_by ms-lg-3 {{_classes}}">
                <small class="d-none d-lg-inline text-muted">Auctions:</small>
                <a role="button" href="#" t-attf-class="dropdown-toggle btn btn-{{navClass}}" data-bs-toggle="dropdown">
                    <span class="d-none d-lg-inline">
                        <t t-if="auctionSortingBy" t-out="auctionSortingBy[0][1]"/>
                        <span t-else="1" t-field="website.auction_default_sort"/>
                    </span>
                    <i class="fa fa-sort-amount-asc d-lg-none"/>
                </a>
                <div class="dropdown-menu dropdown-menu-end" role="menu">
                    <t t-foreach="auction_sortable" t-as="sortby">
                        <a role="menuitem" rel="noindex,nofollow" t-att-href="keep('/products-on-auction', auction=sortby[0])" class="dropdown-item">
                            <span t-out="sortby[1]"/>
                        </a>
                    </t>
                </div>
            </div>
        </template>
    </data>
</odoo>
